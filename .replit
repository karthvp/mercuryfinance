modules = ["nodejs-20", "postgresql-16", "python-base-3.13"]
[nix]
channel = "stable-25_05"
packages = ["unzip"]

[agent]
expertMode = true
integrations = ["javascript_log_in_with_replit:2.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Mercury"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "finance-regressions"

[[workflows.workflow]]
name = "Mercury"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Mercury && npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "finance-regressions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm test"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3001

[deployment]
deploymentTarget = "autoscale"
run = ["node", "Mercury/index.js"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
